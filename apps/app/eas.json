{
    "cli": {
        "version": ">= 14.2.0"
    },
    "build": {
        "base": {
            "node": "22.12.0",
            "bun": "1.1.42",
            "ios": {
                "resourceClass": "m-medium"
            }
        },
        "development": {
            "extends": "base",
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "extends": "base",
            "distribution": "internal",
            "ios": {
                "simulator": true
            }
        },
        "production": {
            "extends": "base"
        }
    },
    "submit": {
        "production": {},
        "preview": {}
    }
}