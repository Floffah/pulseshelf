{
  "name": "@pulseshelf/api",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "concurrently \"tsup --watch\" \"tsc -w --pretty --preserveWatchOutput --emitDeclarationOnly\" \"tsc-alias -w\"",
    "build": "tsup && tsc -b --emitDeclarationOnly && tsc-alias",
    "test": "bun test",
    "format": "prettier --write **/*.{ts,js} src",
    "lint": "tsc --noEmit && eslint --ext .ts,.tsx,.js src"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@pulseshelf/lib": "workspace:*",
    "@pulseshelf/models": "workspace:*",
    "@pulseshelf/eslint-config": "workspace:*",
    "@pulseshelf/prettier-config": "workspace:*",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@trpc/server": "^11.0.0-rc.682",
    "cookie": "^1.0.2",
    "crypto-random-string": "^5.0.0",
    "date-fns": "^4.1.0",
    "discord-api-types": "^0.37.114",
    "drizzle-orm": "^0.38.3",
    "nanoid": "^5.0.9",
    "superjson": "^2.2.2",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "@types/bun": "^1.1.14",
    "concurrently": "^9.1.2",
    "next": "^15.1.3",
    "tsc-alias": "^1.8.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "next": "^15.1.3"
  }
}
