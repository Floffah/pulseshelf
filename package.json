{
  "name": "pulseshelf",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "deps": "ncu -ws --root -x eslint -x react -x react-dom -x @types/react-dom -x @types/react --target semver",
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "setup": "turbo run setup",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "devDependencies": {
    "npm-check-updates": "^17.1.13",
    "turbo": "^2.3.3",
    "turbo-ignore": "^2.3.3"
  },
  "packageManager": "bun@1.1.42",
  "trustedDependencies": [
    "@swc/core",
    "@vercel/speed-insights",
    "dtrace-provider",
    "esbuild",
    "sharp"
  ],
  "patchedDependencies": {
    "react-strict-dom@0.0.32": "patches/react-strict-dom@0.0.32.patch"
  }
}
